# "Bundle content" variant of the loop-dee-loop image: the loop package
# (a baked HLS/DASH segment set) is copied INTO the image, so the result is
# fully self-contained -- no S3, no AWS credentials, no bind mount. Anyone
# with the image can `docker run -p 8080:8080 <image>` and get the stream.
#
# Used by its-a-live's local-docker backend (`[docker] bundle_content =
# true`, or `channel.py image`); never by ecs-express, which keeps content in
# S3. Build context is the loop package directory itself:
#
#   docker build -f loop-dee-loop/Dockerfile.baked \
#       --build-arg BASE_IMAGE=loop-dee-loop:local \
#       --build-arg EPOCH_UTC=1970-01-01T00:00:00Z \
#       -t its-a-live-<channel>:baked <loop-package-dir>
#
# One image == one channel's content. Rebuild it whenever the content (or
# the base image's code) changes.
ARG BASE_IMAGE=loop-dee-loop:local
FROM ${BASE_IMAGE}

# Serve defaults for whoever runs the image bare. docker-entrypoint.sh reads
# these as the starting values; any serve.py flag on the command line wins,
# e.g. `docker run -p 9000:9000 <image> serve.py --port 9000`.
ARG EPOCH_UTC=1970-01-01T00:00:00Z
ARG DVR_WINDOW_SECONDS=30
ARG CONTINUOUS_TIMELINE=false
ENV LOOP_PACKAGE_BAKED=1 \
    EPOCH_UTC=${EPOCH_UTC} \
    DVR_WINDOW_SECONDS=${DVR_WINDOW_SECONDS} \
    CONTINUOUS_TIMELINE=${CONTINUOUS_TIMELINE}

COPY . /var/loop-package/

EXPOSE 8080
CMD ["serve.py"]
