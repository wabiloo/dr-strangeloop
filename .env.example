# Copy to .env (same directory as docker-compose.yml) and fill in.
# See DOCKER_LOCAL.md for the full explanation of each variable.

# REQUIRED. This checkout's own absolute path on YOUR machine -- run `pwd`
# from this directory and paste the result. Must be an absolute path with
# no trailing slash, and must be genuinely where this repo lives on disk
# (not a symlink target, not a path inside another container). Used both
# as the bind-mount source (docker-compose.yml always mounts it at the
# same fixed in-container path, /repo -- the built image itself is shared/
# identical regardless of this value) and, at runtime, so its-a-live's
# local-docker/cdk-deploy code can translate a container path back to its
# real host equivalent when driving Docker through the mounted socket --
# see DOCKER_LOCAL.md and its-a-live/_host_paths.py.
HOST_REPO_ROOT=/absolute/path/to/dr-strangeloop

# REQUIRED. A directory on your machine holding source video/slate assets
# that franken-ts playlists will reference. Mounted read-only at
# /media/library inside the container -- point playlist `assets[].file`
# entries at /media/library/... paths.
MEDIA_ROOT=/absolute/path/to/your/media

# Optional: which host port serves the UI (http://localhost:<port>/admin/).
IGOR_PORT=8090

# Optional: AWS access for its-a-live's aws-media/ecs-express backends.
# Either leave these blank and instead rely on the ~/.aws mount in
# docker-compose.yml (run `aws configure`/`aws sso login` on your host
# first), or fill these in directly instead of using a profile.
AWS_PROFILE=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
